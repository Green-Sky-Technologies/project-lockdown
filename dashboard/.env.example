# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — this file is COMMITTED to git. Put NO real secrets here.
# Real values go in:  dashboard/.env.local  (gitignored)  AND  Vercel → Settings → Environment Variables.
# Copy this file:      cp .env.example .env.local   then fill in .env.local
# ─────────────────────────────────────────────────────────────────────────────

# Clerk publishable key (safe to expose to the browser).
#   GET IT:  Clerk Dashboard → API keys → "Publishable key"
#   USED BY: this dashboard (browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key (SERVER-ONLY — never expose to the browser).
#   GET IT:  Clerk Dashboard → API keys → "Secret key"
#   USED BY: this dashboard (server), and the core (same key)
CLERK_SECRET_KEY=sk_test_...

# Neon pooled connection string — the SAME one the core writes to (read-only here).
#   GET IT:  Neon Console → your project → Connection Details → "Pooled connection"
#            (host contains "-pooler"). Keep the ?sslmode=require&channel_binding=require suffix.
#   USED BY: this dashboard (server) + the core
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# Disclosure control (design doc §11.2): set to "false" to hide the model's
# rationale/evidence in the detail view until counsel signs off. Defaults to shown.
# NEXT_PUBLIC_SHOW_RATIONALE=true
