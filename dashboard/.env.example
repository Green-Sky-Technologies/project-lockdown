# Copy to .env.local (gitignored). Also set these in Vercel project settings.

# Clerk — same instance the extension uses (the dashboard is the extension's sync host)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon — the SAME pooled connection string the core writes to (read-only use here)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# Disclosure control (design doc §11.2): set to "false" to hide the model's
# rationale/evidence in the detail view until counsel signs off. Defaults to shown.
# NEXT_PUBLIC_SHOW_RATIONALE=true
