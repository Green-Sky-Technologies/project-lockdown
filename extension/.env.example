# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — this file is COMMITTED to git.
# Real values go in:  extension/.env  (gitignored) — `npm run build` auto-loads it.
# Copy this file:      cp .env.example .env   then fill in extension/.env
#
# Note: the extension holds NO secret keys. The publishable key is safe to ship,
# and there is intentionally no CLERK_SECRET_KEY / DATABASE_URL here — the whole
# point of the login is that the extension carries no long-lived secret.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk publishable key (safe to expose; baked into the bundle at build time).
#   GET IT:  Clerk Dashboard → API keys → "Publishable key"  (same one the dashboard uses)
CLERK_PUBLISHABLE_KEY=pk_test_...

# The dashboard origin — the extension's Clerk "sync host".
#   local dev: http://localhost:3000   |   prod: your deployed Vercel URL
SYNC_HOST=http://localhost:3000

# Default detection-core URL (overridable at runtime via chrome.storage).
#   local dev: http://localhost:8000   |   prod: your deployed core URL
DEFAULT_CORE_URL=http://localhost:8000
