# Copy to .env (gitignored). The core reads these at startup.

# Anthropic (required for the real classifier; omit to use the deterministic fake)
ANTHROPIC_API_KEY=

# Force the deterministic fake classifier even if a key is present (local dev / CI)
LOCKDOWN_USE_FAKE_CLASSIFIER=0

# Model ids (defaults live in settings.py; override here if needed)
# LOCKDOWN_TIER1_MODEL=claude-haiku-4-5
# LOCKDOWN_TIER2_MODEL=claude-opus-4-8

# Action thresholds (design doc §5.3)
# LOCKDOWN_HIGH_CONFIDENCE=0.7
# LOCKDOWN_LOG_CONFIDENCE=0.3

# --- Auth (Clerk) -------------------------------------------------------
# LOCAL DEV: leave auth off so /classify works anonymously.
LOCKDOWN_REQUIRE_AUTH=false
# PRODUCTION: set true and provide the key + authorized parties below.
# CLERK_SECRET_KEY=sk_live_...
# azp allowlist — the extension origin + dashboard origin. Comma-sep or JSON list.
# LOCKDOWN_CLERK_AUTHORIZED_PARTIES=chrome-extension://<id>,https://dash.example.com

# --- Per-account rate limit (call backstop; pair with an Anthropic Console
#     spend cap as the DOLLAR backstop — set that in the Anthropic dashboard) ---
# LOCKDOWN_RATE_LIMIT_PER_MINUTE=30
# LOCKDOWN_RATE_LIMIT_BURST=10

# --- CORS: default "*" for dev; set explicit origins in prod (comma-sep/JSON) ---
# LOCKDOWN_CORS_ALLOW_ORIGINS=chrome-extension://<id>,https://dash.example.com

# --- Persistence (Neon) — used once A2 lands ---
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.region.aws.neon.tech/db
# LOCKDOWN_PERSIST_VERDICTS=true

# --- LangSmith tracing (optional; read directly by the langsmith SDK) ---
# Leave unset to disable tracing entirely (no third-party calls).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=project-lockdown
