# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — this file is COMMITTED to git. Put NO real secrets here.
# Real values go in:  core/.env  (gitignored)  AND  your host's env settings
#                     (Render → Environment, or Railway → Variables).
# Copy this file:      cp .env.example .env   then fill in core/.env
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key (required for the real classifier; omit to use the fake).
#   GET IT:  console.anthropic.com → API keys
#   ALSO:    set a SPEND CAP + usage alert (console → billing → limits) — the dollar
#            backstop if a token ever leaks; the rate limit below is the call backstop.
ANTHROPIC_API_KEY=

# Force the deterministic fake classifier even if a key is present (local dev / CI)
LOCKDOWN_USE_FAKE_CLASSIFIER=0

# Model ids (defaults live in settings.py; override here if needed)
# LOCKDOWN_TIER1_MODEL=claude-haiku-4-5
# LOCKDOWN_TIER2_MODEL=claude-opus-4-8

# Action thresholds (design doc §5.3)
# LOCKDOWN_HIGH_CONFIDENCE=0.7
# LOCKDOWN_LOG_CONFIDENCE=0.3

# --- Auth (Clerk) -------------------------------------------------------
# LOCAL DEV: leave auth off so /classify works anonymously.
LOCKDOWN_REQUIRE_AUTH=false

# PRODUCTION: set REQUIRE_AUTH=true and provide the two below.
# Clerk secret key (SERVER-ONLY). Same key the dashboard uses.
#   GET IT:  Clerk Dashboard → API keys → "Secret key"
# CLERK_SECRET_KEY=sk_live_...
#
# azp allowlist — the EXTENSION origin + the DASHBOARD origin. Comma-sep or JSON.
#   extension origin: chrome-extension://deocaekmmjagaicbdckdpnhjpebbooch  (fixed by manifest "key")
#   dashboard origin: your deployed Vercel URL
# LOCKDOWN_CLERK_AUTHORIZED_PARTIES=chrome-extension://deocaekmmjagaicbdckdpnhjpebbooch,https://your-dashboard.vercel.app

# --- Per-account rate limit (call backstop; pair with the Anthropic spend cap above) ---
# LOCKDOWN_RATE_LIMIT_PER_MINUTE=30
# LOCKDOWN_RATE_LIMIT_BURST=10

# --- CORS: default "*" for dev; set explicit origins in prod (comma-sep/JSON) ---
#   Same two origins as AUTHORIZED_PARTIES.
# LOCKDOWN_CORS_ALLOW_ORIGINS=chrome-extension://deocaekmmjagaicbdckdpnhjpebbooch,https://your-dashboard.vercel.app

# --- Persistence (Neon) ---
# Neon pooled connection string — the SAME one the dashboard reads from.
#   GET IT:  Neon Console → your project → Connection Details → "Pooled connection"
#            (host contains "-pooler"). The core strips ?query params and forces TLS itself.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# LOCKDOWN_PERSIST_VERDICTS=true

# --- LangSmith tracing (optional; read directly by the langsmith SDK) ---
# Leave unset to disable tracing entirely (no third-party calls).
#   GET IT:  smith.langchain.com → Settings → API keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=project-lockdown
